# Jenkins (standalone HTTP) - copy to .env and set real values.
# Do NOT commit .env.
#
# Quick start (standalone): cp .env.example .env && chmod 600 .env && docker compose up -d
# Traefik/HTTPS: docker compose -f docker-compose.traefik.yml up -d

JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
JENKINS_CONTAINER_NAME=jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_TZ=UTC

# Docker socket mount (/var/run/docker.sock) lets Jenkins control Docker on the host.
# Use only in trusted CI environments and restrict Jenkins permissions/credentials.

# Traefik mode (docker-compose.traefik.yml)
JENKINS_DOMAIN=jenkins.devops-odoo.com
DOCKER_PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# Must match Traefik certificate resolver name (this workspace Traefik uses: le)
CERTSRESOLVER=le
