# Phase 1 — Jenkins installation only (no external integrations)
# Copy to .env, review, then: chmod 600 .env && docker compose config && docker compose up -d
# DO NOT commit .env

JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
JENKINS_CONTAINER_NAME=jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_TZ=UTC