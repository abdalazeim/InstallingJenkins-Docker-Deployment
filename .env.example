# Jenkins (standalone HTTP) - copy to .env and set real values
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
JENKINS_CONTAINER_NAME=jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_TZ=UTC

# Docker socket proxy is optional/advanced; default compose mounts socket directly.
# Mounting /var/run/docker.sock gives Jenkins broad host control - use only in trusted environments.

# Traefik mode (used by docker-compose.traefik.yml)
JENKINS_DOMAIN=jenkins.devops-odoo.com
DOCKER_PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# Must match Traefik certificates resolver name (Traefik repo uses: le)
CERTSRESOLVER=le
