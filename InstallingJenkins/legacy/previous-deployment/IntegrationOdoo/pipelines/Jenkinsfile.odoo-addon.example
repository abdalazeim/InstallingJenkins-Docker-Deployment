// Example Jenkins pipeline skeleton for Odoo addon CI/CD (Odoo 17 / 19).
// Copy/adapt per repository. Store ALL secrets in Jenkins Credentials.
//
// Suggested Jenkins credentials (examples - create in Jenkins UI):
// - 'odoo17-deploy-ssh' (SSH key) or deploy token
// - 'odoo19-deploy-ssh'
// - optional Odoo/API tokens if you use Odoo RPC/REST integrations
//
// Network note: if Jenkins reaches Odoo via public HTTPS domains, no extra Docker network
// is required. If you need internal Docker DNS, attach Jenkins to the relevant network
// with care (avoid breaking Traefik routing).

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    choice(name: 'ODOO_TARGET', choices: ['odoo17', 'odoo19'], description: 'Target Odoo instance')
    string(name: 'ADDON_REPO_BRANCH', defaultValue: 'main', description: 'Addon repo branch/tag (set per job)')
  }

  environment {
    ODOO17_URL = 'https://odoo17.devops-odoo.com'
    ODOO19_URL = 'https://odoo19.devops-odoo.com'
  }

  stages {
    stage('Resolve target') {
      steps {
        script {
          env.ODOO_URL = (params.ODOO_TARGET == 'odoo17') ? env.ODOO17_URL : env.ODOO19_URL
          echo "Target: ${params.ODOO_TARGET} (${env.ODOO_URL}) branch=${params.ADDON_REPO_BRANCH}"
        }
      }
    }

    stage('Checkout addons') {
      steps {
        echo "Configure SCM for your addon repository (Git URL/credentials/branch)."
        // checkout([
        //   $class: 'GitSCM',
        //   branches: [[name: "*/${params.ADDON_REPO_BRANCH}"]],
        //   userRemoteConfigs: [[url: 'https://github.com/ORG/odoo-addons.git', credentialsId: 'git-creds']]
        // ])
      }
    }

    stage('Lint / Test') {
      steps {
        echo "Run lint/tests (flake8/pylint/odoo tests) in a clean runner image. Do not print secrets."
        // sh '''
        //   python3 -m pip install --user -r requirements-dev.txt || true
        //   # pytest / odoo-bin --test-enable ...
        // '''
      }
    }

    stage('Deploy (approved)') {
      when { anyOf { branch 'main'; branch 'master' } }
      steps {
        input message: "Deploy addons to ${params.ODOO_TARGET} (${env.ODOO_URL})?"
        echo "Deploy implementation is environment-specific (SSH/rsync, restart Odoo service, module update)."
        // withCredentials([sshUserPrivateKey(credentialsId: "${params.ODOO_TARGET}-deploy-ssh", keyFileVariable: 'KEY', usernameVariable: 'USER')]) {
        //   sh 'ssh -i "$KEY" -o StrictHostKeyChecking=accept-new "$USER@HOST" "cd /opt/odoo/addons && git pull && docker compose restart odoo"'
        // }
      }
    }
  }

  post {
    always { echo "Pipeline finished for ${params.ODOO_TARGET}" }
  }
}
